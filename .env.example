# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Account identifier: <orgname>-<accountname>, e.g. ABCDEFG-XY12345
# (Snowsight > bottom-left account menu > Connect a tool to Snowflake)
SNOWFLAKE_ACCOUNT=your_org-your_account

# Service user created in snowflake/00_setup.sql
SNOWFLAKE_USER=DBT_SVC
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=OLIST_WH
SNOWFLAKE_DATABASE=OLIST

# Key-pair auth (recommended). Absolute path to the PRIVATE key, kept outside the repo.
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/outside/repo/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Password auth: only used by ingestion/load_raw.py if no key path is set.
# SNOWFLAKE_PASSWORD=

# dbt target: dev (default), prod, or ci
DBT_TARGET=dev
